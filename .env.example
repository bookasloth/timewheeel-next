# Copy to .env.local and fill in. All optional — site works without them (placeholders/no-ops).

# Book A Demo button target (defaults to https://timewheel.co.in/book-a-demo)
NEXT_PUBLIC_CALENDLY_URL=

# Book A Sloth booking page the /book-a-demo page links to.
# Defaults to https://bookasloth.com/sndatarkar; set to a dedicated Timewheel
# booking page when one exists.
NEXT_PUBLIC_BAS_BOOKING_URL=

# Google Business "write a review" deep link for the /review page's
# "Leave Google review" button. Get it from Google Business Profile -> Ask for
# reviews, or use https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID
# Falls back to a Google search for the business when unset.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Google Analytics 4 (GA renders only when set)
NEXT_PUBLIC_GA_ID=

# Meta Pixel numeric id — used by BOTH the browser pixel and server-side CAPI.
# Browser reads NEXT_PUBLIC_META_PIXEL_ID; server CAPI reads META_PIXEL_ID.
# Both fall back to the live pixel id if unset.
META_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API — server-side 'Lead' events (deduped with the browser pixel).
# Create a system-user access token in Meta Events Manager. CAPI stays off until set.
META_CAPI_ACCESS_TOKEN=
# Graph API version, optional (defaults to v21.0)
META_GRAPH_VERSION=

# Google Tag Manager container id. Browser reads NEXT_PUBLIC_GTM_ID; both fall back
# to the live container if unset. GTM carries GA4 + the click-conversion tags.
GTM_ID=
NEXT_PUBLIC_GTM_ID=

# Microsoft Clarity (heatmaps + session replay). Loads only after cookie consent.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# PostHog (first-party product analytics, always-on). Key + host.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Resend — newsletter signups email out only when all three are set
RESEND_API_KEY=
RESEND_FROM=Timewheel <hello@timewheel.co.in>
NEWSLETTER_TO=you@timewheel.co.in

# Resend lead-nurture audience. Consented leads (marketing_consent=true) are added
# to this audience by /api/lead for later nurture broadcasts. Uses RESEND_API_KEY
# above. Unset -> lead -> Resend sync silently no-ops.
RESEND_LEADS_AUDIENCE_ID=

# Lifecycle emails (delivered/upsell). Shared secret guarding /api/lifecycle; the
# Supabase Database Webhook sends it as the x-lifecycle-secret header. The route
# fails closed (503) when this is unset. Generate a long random value.
LIFECYCLE_SECRET=

# Supabase — server-side lead persistence (authoritative leads store). The lead
# API writes to the `leads` table via PostgREST using the secret (service-role)
# key, so it bypasses RLS and is never exposed to the browser. Leads still email
# out via SMTP as a backup; if these are unset, DB persistence silently no-ops.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional, for future client-side reads (not used by the lead flow):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------- Zoho Payments (/pay checkout) ----------
# Payments REQUIRE SUPABASE_URL + SUPABASE_SECRET_KEY above (table: payments,
# migration supabase/migrations/0003_payments.sql). Receipts go out via RESEND_API_KEY.
# Zoho Payments > Settings > Developer Space > Account ID
NEXT_PUBLIC_ZOHO_PAY_ACCOUNT_ID=
# Zoho Payments > Settings > Developer Space > API Key
NEXT_PUBLIC_ZOHO_PAY_API_KEY=
# true = paymentssandbox.zoho.in + test mode widget (needs sandbox enabled by Zoho support)
NEXT_PUBLIC_ZOHO_PAY_SANDBOX=false
# Secret, server only. Create a Self Client / server app at https://api-console.zoho.in/add?client_type=ORG
ZOHO_PAY_CLIENT_ID=
ZOHO_PAY_CLIENT_SECRET=
# Must match the redirect URI registered on the Zoho app
ZOHO_PAY_REDIRECT_URI=http://localhost:3000/
# From: node --env-file=.env.local scripts/zoho-auth.mjs
ZOHO_PAY_REFRESH_TOKEN=
# Zoho Payments > Settings > Webhooks, URL https://timewheel.co.in/api/zoho/webhook,
# event payment.succeeded (the signing key is shown once when the webhook is created)
ZOHO_PAY_WEBHOOK_SIGNING_KEY=
# Who gets the "payment received" alert (defaults to LEAD_TO, then team@timewheel.co.in)
PAYMENTS_NOTIFY_TO=
