# Copy to .env.local and fill in. All optional — site works without them (placeholders/no-ops).

# Book A Demo button target (defaults to https://timewheel.co.in/book-a-demo)
NEXT_PUBLIC_CALENDLY_URL=

# Book A Sloth booking page the /book-a-demo page links to.
# Defaults to https://bookasloth.com/sndatarkar; set to a dedicated Timewheel
# booking page when one exists.
NEXT_PUBLIC_BAS_BOOKING_URL=

# Google Analytics 4 (GA renders only when set)
NEXT_PUBLIC_GA_ID=

# Meta Pixel numeric id — used by BOTH the browser pixel and server-side CAPI.
# Browser reads NEXT_PUBLIC_META_PIXEL_ID; server CAPI reads META_PIXEL_ID.
# Both fall back to the live pixel id if unset.
META_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API — server-side 'Lead' events (deduped with the browser pixel).
# Create a system-user access token in Meta Events Manager. CAPI stays off until set.
META_CAPI_ACCESS_TOKEN=
# Graph API version, optional (defaults to v21.0)
META_GRAPH_VERSION=

# Google Tag Manager container id. Browser reads NEXT_PUBLIC_GTM_ID; both fall back
# to the live container if unset. GTM carries GA4 + the click-conversion tags.
GTM_ID=
NEXT_PUBLIC_GTM_ID=

# Microsoft Clarity (heatmaps + session replay). Loads only after cookie consent.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# PostHog (first-party product analytics, always-on). Key + host.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Resend — newsletter signups email out only when all three are set
RESEND_API_KEY=
RESEND_FROM=Timewheel <hello@timewheel.co.in>
NEWSLETTER_TO=you@timewheel.co.in

# Supabase — server-side lead persistence (authoritative leads store). The lead
# API writes to the `leads` table via PostgREST using the secret (service-role)
# key, so it bypasses RLS and is never exposed to the browser. Leads still email
# out via SMTP as a backup; if these are unset, DB persistence silently no-ops.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional, for future client-side reads (not used by the lead flow):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
